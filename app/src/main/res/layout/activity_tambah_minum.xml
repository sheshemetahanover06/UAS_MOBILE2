<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#60E8F7">

    <!-- Status Bar dengan Jam dan Baterai -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:layout_marginTop="-16dp"
        android:layout_marginBottom="8dp">

        <!-- Jam di sebelah kiri -->
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="9:41"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- Baterai di sebelah kanan -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_battery"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tv_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000" />

        </LinearLayout>

    </RelativeLayout>

    <!-- ScrollView untuk konten yang bisa di-scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- JUDUL Tambah Minum -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tambah Minum"
                android:textSize="24sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- Jenis Minuman -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jenis Minuman"
                android:textSize="14sp"
                android:textColor="#1A237E"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editJenisMinuman"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contoh: Air Putih, Jus, Kopi"
                android:background="@android:drawable/editbox_background"
                android:padding="14dp"
                android:layout_marginBottom="20dp" />

            <!-- Jumlah Minum -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jumlah Minum"
                android:textSize="14sp"
                android:textColor="#1A237E"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editJumlahMinum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contoh: 250 ml"
                android:background="@android:drawable/editbox_background"
                android:padding="14dp"
                android:layout_marginBottom="20dp"
                android:inputType="number" />

            <!-- Waktu Minum -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waktu Minum"
                android:textSize="14sp"
                android:textColor="#1A237E"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editWaktuMinum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contoh: 08:00"
                android:background="@android:drawable/editbox_background"
                android:padding="14dp"
                android:layout_marginBottom="20dp"
                android:inputType="time" />

            <!-- Catatan (Opsional) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Catatan (Opsional)"
                android:textSize="14sp"
                android:textColor="#1A237E"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editCatatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tambahkan catatan..."
                android:background="@android:drawable/editbox_background"
                android:padding="14dp"
                android:layout_marginBottom="28dp" />

            <!-- TOMBOL SIMPAN -->
            <Button
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Simpan"
                android:textSize="16sp"
                android:backgroundTint="#0891B2"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/beranda" />

            <TextView
                android:id="@+id/navBeranda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Beranda"
                android:textColor="#999999"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/riwayat" />

            <TextView
                android:id="@+id/navRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Riwayat"
                android:textColor="#4FC3F7"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/pengaturan" />

            <TextView
                android:id="@+id/navPengaturan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pengaturan"
                android:textColor="#999999"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>